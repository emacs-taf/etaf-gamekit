! SPDX-License-Identifier: GPL-3.0-or-later
Constant Story "THE LAST BEACON";
Constant Headline "^A small ETAF game integration example.^";
Include "parser";
Include "verblib";

Object Workshop "Workshop"
  with description "A brass lantern waits on the workbench. The courtyard lies north.",
       n_to Courtyard,
  has light;
Object -> lantern "brass lantern"
  with name 'brass' 'lantern' 'lamp',
       description "A dependable lantern with a simple switch.",
       after [;
           SwitchOn: give self light;
           SwitchOff: give self ~light;
       ],
  has switchable;
Object Courtyard "Courtyard"
  with description "The workshop is south. A dark observatory stands north.",
       s_to Workshop, n_to Observatory,
  has light;
Object -> prism "glass prism"
  with name 'glass' 'prism',
       description "It catches the last light of the evening.";
Object Observatory "Observatory"
  with description "The beacon's empty socket faces the sea. The courtyard is south.",
       s_to Courtyard;
Object -> beacon "beacon"
  with name 'beacon' 'socket',
       description "A glass prism would fit the socket.",
       before [;
           Receive:
               if (noun == prism) {
                   move prism to self;
                   print "The prism catches the lantern light. The last beacon shines again!^";
                   deadflag = 2;
                   rtrue;
               }
       ],
  has container open static;
[ Initialise;
  location = Workshop;
  "^Restore the coastal beacon before nightfall. Try LOOK, TAKE LANTERN, and NORTH.^";
];
Include "grammar";
